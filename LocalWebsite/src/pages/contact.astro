---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
// Replace with your own form endpoint (Formspree, Netlify Forms, Getform, etc.)
const formAction = 'https://formspree.io/f/your-form-id';
---
<Layout title="Contact" description={`Book a table or get in touch with ${site.fullName}.`}>
  <h1>Contact</h1>

  <div class="grid">
    <section class="details">
      <h2>Get in touch</h2>
      <p>For bookings, groups, rooms or anything else, give us a call or send a message and we will get back to you.</p>
      <p>
        <a href={`tel:${site.phoneHref}`}>{site.phone}</a><br />
        {site.email && <><a href={`mailto:${site.email}`}>{site.email}</a><br /></>}
        <a href={site.instagram.url} target="_blank" rel="noopener">Instagram @{site.instagram.handle}</a><br />
        <a href={site.facebook.url} target="_blank" rel="noopener">Facebook</a>
      </p>
      <address>
        {site.address.map((line) => (<>{line}<br /></>))}
        <a href={site.mapUrl} target="_blank" rel="noopener">Get directions</a>
      </address>
    </section>

    <form action={formAction} method="POST">
      <label>Name
        <input type="text" name="name" autocomplete="name" required />
      </label>
      <label>Email
        <input type="email" name="email" autocomplete="email" required />
      </label>
      <label>Message
        <textarea name="message" rows="6" placeholder="Date, time and number of people if you are booking" required></textarea>
      </label>
      <button class="btn" type="submit">Send message</button>
    </form>
  </div>
</Layout>

<style>
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr)); gap: 3rem 5rem; margin-top: 2.5rem; }
  .details { border-top: 1px solid var(--gold); padding-top: 1.5rem; }
  address { font-style: normal; margin-top: 1.5rem; color: var(--text-soft); }
  form { display: grid; gap: 1.25rem; border-top: 1px solid var(--gold); padding-top: 1.5rem; }
  label { display: grid; gap: .35rem; font-family: var(--serif); font-size: 1.05rem; }
  input, textarea { font: 1rem var(--sans); color: var(--text); background: var(--panel); border: 1px solid var(--text-soft); border-radius: 2px; padding: .7rem .8rem; width: 100%; }
  button { justify-self: start; }
</style>
