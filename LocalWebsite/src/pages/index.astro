---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
---
<Layout>
  <section class="hero">
    <h1>A great pint, good food and the Shannon on the doorstep.</h1>
    <p class="lede">
      {site.fullName} is a family run bar and restaurant in the heart of {site.town},
      on the banks of the River Shannon. Friendly staff, live music most weekends
      and plenty of room to eat outside.
    </p>
    <p class="actions">
      <a class="btn" href="/menu">See the menu</a>
      <a class="plain" href="/contact">Get in touch</a>
    </p>
  </section>

  <section class="trio">
    <article>
      <h2>The restaurant</h2>
      <p>Good, honest food served by a team that knows the regulars by name, with a newly opened dining area for bigger tables and special occasions.</p>
    </article>
    <article>
      <h2>The bar</h2>
      <p>A proper pint, a warm welcome and live music most weekends. Come in for one and see how long you stay.</p>
    </article>
    <article>
      <h2>Outside</h2>
      <p>Plenty of outdoor dining space for long evenings and sunny afternoons in the middle of town.</p>
    </article>
  </section>

  <section class="follow">
    <h2>Opening times and news</h2>
    {site.hours.length > 0 ? (
      <dl>
        {site.hours.map((h) => (<><dt>{h.days}</dt><dd>{h.time}</dd></>))}
      </dl>
    ) : (
      <p>
        For opening times, live music nights and daily specials, follow us on
        <a href={site.instagram.url} target="_blank" rel="noopener">Instagram (@{site.instagram.handle})</a>
        or call <a href={`tel:${site.phoneHref}`}>{site.phone}</a>.
      </p>
    )}
    <p><a href="/info">More about us and how to find us</a></p>
  </section>
</Layout>

<style>
  .hero { padding: clamp(2rem, 8vw, 6rem) 0 4rem; max-width: 52rem; }
  .hero h1 { font-weight: 300; font-style: italic; }
  .lede { font-size: 1.25rem; color: var(--text-soft); }
  .actions { display: flex; gap: 1.75rem; align-items: center; margin-top: 2rem; }
  .plain { font-family: var(--serif); font-style: italic; font-size: 1.2rem; }
  .trio { display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: 3rem; padding: 3rem 0; border-top: 1px solid var(--gold); }
  .follow { padding-top: 3rem; border-top: 1px solid var(--gold); }
  dl { display: grid; grid-template-columns: max-content 1fr; gap: .5rem 3rem; margin: 1.5rem 0; }
  dt { font-family: var(--serif); font-size: 1.15rem; }
  dd { margin: 0; color: var(--text-soft); }
  @media (max-width: 480px) { dl { grid-template-columns: 1fr; gap: 0; } dd { margin-bottom: .75rem; } }
</style>
