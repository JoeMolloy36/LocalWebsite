---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
---
<Layout title="Info" description={`About ${site.fullName}, opening times and how to find us in ${site.town}.`}>
  <h1>Info</h1>

  <div class="grid">
    <section>
      <h2>About us</h2>
      <p>
        {site.fullName} sits right in the centre of {site.town}, beside the River Shannon.
        It is a family run business built on a great pint, excellent food and friendly staff.
      </p>
      <p>
        We have live music most weekends, plenty of outdoor dining space, and a new dining
        area and accommodation for those who want to stay a night or two.
      </p>
    </section>

    <section>
      <h2>Opening times</h2>
      {site.hours.length > 0 ? (
        <dl>
          {site.hours.map((h) => (<><dt>{h.days}</dt><dd>{h.time}</dd></>))}
        </dl>
      ) : (
        <p>
          Opening times can change with the season and with live music nights, so please
          check our <a href={site.instagram.url} target="_blank" rel="noopener">Instagram</a>
          or call <a href={`tel:${site.phoneHref}`}>{site.phone}</a>.
        </p>
      )}
      {site.hoursNote && <p class="note">{site.hoursNote}</p>}
    </section>

    <section>
      <h2>Find us</h2>
      <address>
        {site.address.map((line) => (<>{line}<br /></>))}
      </address>
      <p>We are on the Main Street in {site.town}, close to the Shannon. <a href={site.mapUrl} target="_blank" rel="noopener">Get directions</a></p>
    </section>

    <section>
      <h2>Good to know</h2>
      <p>Please tell us about any allergies when you order. For groups, bookings and rooms, give us a call and we will sort it out.</p>
    </section>
  </div>
</Layout>

<style>
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr)); gap: 3rem 4rem; margin-top: 2.5rem; }
  section { border-top: 1px solid var(--gold); padding-top: 1.5rem; }
  address { font-style: normal; font-size: 1.15rem; margin-bottom: 1rem; }
  dl { display: grid; grid-template-columns: max-content 1fr; gap: .4rem 2rem; margin: 0 0 1rem; }
  dt { font-family: var(--serif); }
  dd { margin: 0; color: var(--text-soft); }
  .note { color: var(--text-soft); font-style: italic; }
</style>
