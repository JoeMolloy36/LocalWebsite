---
import { site, nav } from '../data/site';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href;
---
<header class="masthead">
  <nav class="side left" aria-label="Primary">
    {nav.left.map((l) => (
      <a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>
    ))}
  </nav>

  <a class="wordmark" href="/" aria-label={`${site.fullName}, home`}>
    <svg class="mark" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M12 2 22 12 12 22 2 12Z" fill="none" stroke="currentColor" stroke-width="1.200"/>
      <path d="M12 7 17 12 12 17 7 12Z" fill="currentColor"/>
    </svg>
    <span class="name">{site.name}</span>
    <span class="tag">{site.tagline}</span>
  </a>

  <nav class="side right" aria-label="Secondary">
    {nav.right.map((l) => (
      <a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>
    ))}
  </nav>
</header>

<style>
  .masthead {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 2rem;
    padding: 1.75rem clamp(1rem, 4vw, 3rem) 1.5rem;
    border-bottom: 1px solid var(--gold);
    box-shadow: 0 5px 0 -4px var(--bg), 0 5px 0 -3px var(--gold);
    margin-bottom: 6px;
  }
  .side { display: flex; gap: clamp(1rem, 3vw, 2.5rem); font-family: var(--serif); font-style: italic; font-size: 1.2rem; }
  .side.left { justify-content: flex-end; }
  .side.right { justify-content: flex-start; }
  .side a { color: var(--text); text-decoration: none; padding: .25rem 0; background: linear-gradient(var(--gold), var(--gold)) 0 100% / 0 1px no-repeat; transition: background-size .25s ease; }
  .side a:hover, .side a:focus-visible, .side a[aria-current='page'] { background-size: 100% 1px; }
  .wordmark { display: flex; flex-direction: column; align-items: center; text-decoration: none; color: var(--text); text-align: center; line-height: 1; }
  .mark { width: .9rem; color: var(--gold); margin-bottom: .5rem; }
  .name { font-family: var(--serif); font-weight: 500; font-size: clamp(1.8rem, 4vw, 2.8rem); letter-spacing: .01em; font-variation-settings: 'SOFT' 100, 'WONK' 1; }
  .tag { font-size: .85rem; margin-top: .45rem; color: var(--text-soft); letter-spacing: .12em; }

  @media (max-width: 720px) {
    .masthead { display: flex; flex-wrap: wrap; justify-content: center; gap: .9rem 1.5rem; padding-top: 1.25rem; }
    .wordmark { width: 100%; }
    .side { font-size: 1.1rem; }
  }
</style>
