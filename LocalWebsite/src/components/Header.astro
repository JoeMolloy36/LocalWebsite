---
import { site, nav } from '../data/site';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href;
---
<header class="masthead">
  <nav class="side left" aria-label="Primary">
    {nav.left.map((l) => (
      <a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>
    ))}
  </nav>

  <a class="wordmark" href="/" aria-label={`${site.name}, home`}>
    <svg class="pear" viewBox="0 0 24 32" aria-hidden="true">
      <path d="M12 4c1.200 0 2 1 2 2.500 0 1.200-.5 2-1.400 3C14.800 10.600 18 13 18 18.500c0 5-3.200 9.500-6 9.500s-6-4.500-6-9.500C6 13 9.200 10.600 11.400 9.500 10.500 8.500 10 7.700 10 6.500 10 5 10.800 4 12 4Z" fill="none" stroke="currentColor" stroke-width="1.200"/>
      <path d="M12.500 3.500c1-1.200 2.600-1.700 4-1.400" fill="none" stroke="currentColor" stroke-width="1.200" stroke-linecap="round"/>
    </svg>
    <span class="name">{site.name}</span>
    <span class="tag">{site.tagline}</span>
  </a>

  <nav class="side right" aria-label="Secondary">
    {nav.right.map((l) => (
      <a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>
    ))}
  </nav>
</header>

<style>
  .masthead {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 2rem;
    padding: 1.75rem clamp(1rem, 4vw, 3rem) 1.5rem;
    border-bottom: 1px solid var(--brass);
    box-shadow: 0 5px 0 -4px var(--plaster), 0 5px 0 -3px var(--brass);
    margin-bottom: 6px;
  }
  .side { display: flex; gap: clamp(1rem, 3vw, 2.5rem); font-family: var(--serif); font-style: italic; font-size: 1.2rem; }
  .side.left { justify-content: flex-end; }
  .side.right { justify-content: flex-start; }
  .side a { color: var(--ink); text-decoration: none; padding: .25rem 0; background: linear-gradient(var(--brass), var(--brass)) 0 100% / 0 1px no-repeat; transition: background-size .25s ease; }
  .side a:hover, .side a:focus-visible, .side a[aria-current='page'] { background-size: 100% 1px; }
  .wordmark { display: flex; flex-direction: column; align-items: center; text-decoration: none; color: var(--ink); text-align: center; line-height: 1; }
  .pear { width: 1.1rem; color: var(--brass); margin-bottom: .45rem; }
  .name { font-family: var(--serif); font-weight: 500; font-size: clamp(1.8rem, 4vw, 2.8rem); letter-spacing: .01em; font-variation-settings: 'SOFT' 100, 'WONK' 1; }
  .tag { font-size: .85rem; margin-top: .45rem; color: var(--ink-soft); letter-spacing: .12em; }

  @media (max-width: 720px) {
    .masthead { display: flex; flex-wrap: wrap; justify-content: center; gap: .9rem 1.5rem; padding-top: 1.25rem; }
    .wordmark { width: 100%; }
    .side { font-size: 1.1rem; }
  }
</style>
