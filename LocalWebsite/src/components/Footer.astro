---
import { site } from '../data/site';
---
<footer>
  <p class="brand">{site.fullName}</p>
  <p class="line">{site.address.join(', ')}</p>
  <p class="line">
    <a href={`tel:${site.phoneHref}`}>{site.phone}</a>
    {site.email && <> · <a href={`mailto:${site.email}`}>{site.email}</a></>}
  </p>
  <p class="line">
    <a href={site.instagram.url} target="_blank" rel="noopener">Instagram</a> ·
    <a href={site.facebook.url} target="_blank" rel="noopener">Facebook</a>
  </p>
  <p class="small">&copy; {new Date().getFullYear()} {site.fullName}</p>
</footer>
<style>
  footer { margin-top: 6rem; padding: 2.5rem 1rem 3rem; text-align: center; border-top: 1px solid var(--gold); color: var(--text-soft); }
  .brand { font-family: var(--serif); font-size: 1.3rem; color: var(--text); margin: 0 auto .75rem; max-width: none; }
  .line { margin: .2rem auto; max-width: none; }
  .small { margin: 1.25rem auto 0; font-size: .85rem; max-width: none; }
  a { color: inherit; }
</style>
